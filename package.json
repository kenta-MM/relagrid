    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^26.1.0",
    "prettier": "^3.9.8",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.7.3",
    "vite": "^6.4.0",
    "vitest": "^4.1.11"
