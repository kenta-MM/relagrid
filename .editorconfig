root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{ts,tsx,js,jsx,json,md,yml,yaml,toml,css,scss,html}]
indent_style = space
indent_size = 2

[*.rs]
indent_style = space
indent_size = 4

[*.{md,markdown}]
trim_trailing_whitespace = false
